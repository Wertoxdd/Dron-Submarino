                       2     ;                         VARIABLES DIRECCIONABLES POR BITS
                       3     ;------------------------------------------------------------------------------------------
                             ---
                       4     
  0000                 5     FLAG_10MS EQU 0x20.0       ; lo pone a 1 la ISR de T0
  0001                 6     FLAG_1S EQU 0x20.1         ; lo pone a 1 el GEN_COD_EVENT
  0002                 7     FLAG_BOTON EQU 0x20.2      ; lo pone a 1 la ISR de INT0
  0003                 8     FLAG_FIN EQU 0x20.3        ; si se pone a 1, la subida termina el recorrido
  0004                 9     BIT_SENTIDO EQU 0x20.4     ; si esta a 1 significa subir, a 0 bajar (se copia a P1.5)
                      10     
                      11     ;------------------------------------------------------------------------------------------
                             ---
                      12     ;                                  VARIABLES
                      13     ;------------------------------------------------------------------------------------------
                             ---
                      14     
  0030                15     ESTADO EQU 0x30            ; 0=reposo, 1=vertical, 2=horizontal
  0031                16     EVENTO EQU 0x31            ; da valores del 0 al 4
  0032                17     PUNTERO EQU 0x32           ; guarda la direccion de la siguiente instruccion
  0033                18     INSTR EQU 0x33             ; guarda el nibble alto de lo que lee en la direccion que guarda
                              PUNTERO.
  0034                19     PARAM EQU 0x34             ; guarda el nibble bajo de lo que lee en la direccion que guarda
                              PUNTERO.
  0035                20     ACCION EQU 0x35            ; es la instruccion horizontal que se va a hacer
  0036                21     TIEMPO  EQU 0x36           ; son los segundos que quedan
  0037                22     OBJETIVO EQU 0x37          ; codigo del ADC de la profundidad a alcanzar
  0038                23     PROF EQU 0x38              ; ultima medida del canal 0 del ADC
  0039                24     DIST EQU 0x39              ; ultima medida del canal 1 del ADC
  003A                25     CONT_TICKS EQU 0x3A        ; se carga con el valor 100, y decrementa por cada tick de 10ms
                      26     
                      27     ;------------------------------------------------------------------------------------------
                             ---
                      28     ;                                    TIMERS     
                      29     ;------------------------------------------------------------------------------------------
                             ---
                      30     
  00B1                31     TH_RECARGA EQU 0xB1       ; valor de recarga del TH para el timer 0 de 10ms (TH0)
  00E0                32     TL_RECARGA EQU 0xE0       ; valor de recarga del TL para el timer 0 de 10ms (TL0)
  0064                33     TICKS_SEC EQU 0x64        ; numero de ticks que tiene que hacer en un segundo
                      34     
                      35     ;------------------------------------------------------------------------------------------
                             ---
                      36     ;                                 INSTRUCCIONES 
                      37     ;------------------------------------------------------------------------------------------
                             ---
                      38     
  00C0                39     C_PROFUNDIDAD EQU 0xC0    ; control de profundidad, el nivel va en el nibble bajo
  00A0                40     A_AVANZAR EQU 0xA0        ; control de avanzar, los segundos van en el nibble bajo
  00D0                41     D_DERECHA EQU 0xD0        ; control de giro a la derecha, los segundos van en el nibble baj
                             o
  00E0                42     E_IZQUIERDA EQU 0xE0      ; control de giro a la izquierda, los segundos van en el nibble b
                             ajo
  00F0                43     F_FIN EQU 0xF0            ; fin del programa
